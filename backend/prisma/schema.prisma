datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String?
  role         String        @default("MEMBER") // ADMIN or MEMBER
  createdAt    DateTime      @default(now())
  chatSessions ChatSession[]
  feedbacks    Feedback[]
}

model Feedback {
  id             String         @id @default(uuid())
  content        String
  source         String         @default("MANUAL") // CSV_UPLOAD, MANUAL, EMAIL, etc.
  rawMetadata    String?        // Stores extra JSON/metadata as string if needed
  createdAt      DateTime       @default(now())
  receivedAt     DateTime       @default(now())
  
  // AI/Analytics fields (nullable because they are computed asynchronously/by other agents)
  sentiment      Float?         // -1.0 to 1.0
  category       String         @default("UX_ISSUE") // BUG_REPORT, FEATURE_REQUEST, etc.
  productArea    String         @default("General") // e.g., Checkout, Login
  detectedIssue  String?        // Summarized issue
  
  releaseId      String?
  release        Release?       @relation(fields: [releaseId], references: [id])
  
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])

  // Relations for semantic similarity clustering
  correlations   Correlation[]  @relation("SourceFeedback")
  referencedIn   Correlation[]  @relation("TargetFeedback")
}

model Release {
  id          String     @id @default(uuid())
  version     String     @unique // e.g. "v1.0"
  description String?
  deployedAt  DateTime
  feedbacks   Feedback[]
}

model Correlation {
  id               String   @id @default(uuid())
  sourceFeedbackId String
  targetFeedbackId String
  confidenceScore  Float    // 0.0 to 1.0 similarity score
  reason           String   // AI reasoning
  createdAt        DateTime @default(now())

  sourceFeedback   Feedback @relation("SourceFeedback", fields: [sourceFeedbackId], references: [id], onDelete: Cascade)
  targetFeedback   Feedback @relation("TargetFeedback", fields: [targetFeedbackId], references: [id], onDelete: Cascade)

  @@unique([sourceFeedbackId, targetFeedbackId])
}

model Alert {
  id          String    @id @default(uuid())
  title       String    // e.g. "Spike in checkout errors"
  message     String
  type        String    @default("WARNING") // CRITICAL, WARNING, INFO
  productArea String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model ChatSession {
  id        String        @id @default(uuid())
  title     String        @default("New Chat")
  createdAt DateTime      @default(now())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      String      // "user" or "assistant"
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
